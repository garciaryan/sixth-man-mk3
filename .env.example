# Copy to .env.local for local development. On Fly, set these with `fly secrets set`.

# Yahoo developer app (https://developer.yahoo.com/apps/). Permissions: OpenID Connect + Fantasy Sports (Read).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Public HTTPS origin. The OAuth redirect is ${APP_URL}/api/auth/callback. Local: https://localhost:3000
APP_URL=https://localhost:3000

# The league everyone compares in, e.g. 466.l.12345. Optional: the admin can pick it on /settings instead.
LEAGUE_KEY=

# Your Yahoo GUID. You are the admin, and your Yahoo connection drives the nightly sync.
ADMIN_YAHOO_GUID=

# Signs session cookies. Optional: generated once into DATA_DIR/session-secret when unset.
SESSION_SECRET=

# Bearer token for POST /api/sync (the GitHub Actions cron sends it).
SYNC_TOKEN=

# Where SQLite lives. Fly: /data (the volume). Local default: ./data
DATA_DIR=./data
